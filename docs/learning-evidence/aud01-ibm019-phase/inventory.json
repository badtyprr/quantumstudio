    },
    {
      "index": 12,
      "id": "d24d14eb",
      "type": "markdown",
      "sha256": "96d9ba626e2b6b246339373dfcaa477d11b3ed08b24f9019445120eeb59ae6b0",
      "execution": "not executed",
      "source": null
    },
    {
      "index": 13,
      "id": "5b31e311",
      "type": "code",
      "sha256": "a12dd3741f410b738ec09a1b965ea0e67df188e034ac38a9ce7f536c0d6d6714",
      "execution": "not executed",
      "source": "def deutsch_algorithm(function: QuantumCircuit):\n    # Determine if a one-bit function is constant or balanced.\n\n    qc = compile_circuit(function)\n\n    result = AerSimulator().run(qc, shots=1, memory=True).result()\n    measurements = result.get_memory()\n    if measurements[0] == \"0\":\n        return \"constant\"\n    return \"balanced\""
    },
