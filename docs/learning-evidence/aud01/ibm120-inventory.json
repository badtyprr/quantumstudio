      "literal": "$$\n\\hat{U}_{ST(2k)}\\left(t\\right) = \\left[ \\hat{U}_{ST(2k-2)}\\left(p_k t\\right) \\right]^2 \\hat{U}_{ST(2k-2)}\\left( (1- 4 p_k) t\\right)\\left[ \\hat{U}_{ST(2k-2)}\\left(p_k t\\right) \\right]^2\n$$",
      "status": "exact",
      "display": "U_(2 · k · S · T) · t − ((U_((2 · k − 2) · S · T) · \"p_k\" · t)^2 · U_((2 · k − 2) · S · T) · (1 − 4 · \"p_k\") · t · (U_((2 · k − 2) · S · T) · \"p_k\" · t)^2) = 0",
      "copy": "(qadd(qmul(−1,qadjacent(qadjacent(qadjacent(qpower(vector(qadjacent(qindexedlabel(\"U_\",qmul(qmul('S','T'),qsub(qadjacent(2,'k'),2)),\"\"),qadjacent(\"p_k\",'t'))),2),qindexedlabel(\"U_\",qmul(qmul('S','T'),qsub(qadjacent(2,'k'),2)),\"\")),qadjacent(qsub(1,qadjacent(4,\"p_k\")),'t')),qpower(vector(qadjacent(qindexedlabel(\"U_\",qmul(qmul('S','T'),qsub(qadjacent(2,'k'),2)),\"\"),qadjacent(\"p_k\",'t'))),2))),qadjacent(qindexedlabel(\"U_\",qmul(qmul('S','T'),qadjacent(2,'k')),\"\"),'t')))==(0)"
    },
    {
      "id": "IBM120-90815385-M067",
      "cell": 54,
      "start": 712,
      "end": 761,
      "literal": "$$\np_k = 1 / \\left(4-4^{\\frac{1}{2k-1}}\\right)\n$$",
