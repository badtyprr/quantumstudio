  "checks": [
    {
      "figure": "cNOT-copy.svg",
      "expression": "CNOT*(|0>@|0>)",
      "expected": "|00>",
      "result": "matrix(4,1,[1,0,0,0])"
    },
    {
      "figure": "cNOT-copy.svg",
      "expression": "CNOT*(|1>@|0>)",
      "expected": "|11>",
      "result": "matrix(4,1,[0,0,0,1])"
    },
    {
      "figure": "cNOT-copy.svg",
      "expression": "SWAP*CNOT*SWAP*|10>",
      "expected": "|10>",
      "result": "matrix(4,1,[0,0,1,0])"
    },
    {
      "figure": "discriminate.svg",
      "expression": "probs((I@H)*(|0>@|+>))",
      "expected": "[1;0;0;0]",
      "result": "matrix(4,1,[1,0,0,0])"
    },
    {
      "figure": "discriminate.svg",
      "expression": "probs(|0>@|+>)",
      "expected": "[1/2;1/2;0;0]",
      "result": "matrix(4,1,[1 ∕ 2,1 ∕ 2,0,0])"
    },
    {
      "figure": "discriminate.svg",
      "expression": "probs((I@H)*(|0>@|->))",
      "expected": "[0;1;0;0]",
      "result": "matrix(4,1,[0,1,0,0])"
    },
    {
      "figure": "discriminate.svg",
      "expression": "probs(|0>@|->)",
      "expected": "[1/2;1/2;0;0]",
      "result": "matrix(4,1,[1 ∕ 2,1 ∕ 2,0,0])"
    }
  ]
