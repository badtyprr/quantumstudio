      "start": 1324,
      "end": 1386,
      "literal": "$$\n|\\psi_\\text{var}\\rangle=\\sum_{i=0}^n c_i |\\psi_i\\rangle,\n$$",
      "status": "exact",
      "display": "|ψ_var⟩ = ∑_{k=0}^{n} (c_k |ψ_k⟩)",
      "copy": "qcompare(qketstate(\"ψ_var\"),qsum(qadjacent(qindexedlabel(\"c_\",\"qboundindex_0\",\"\"),qindexedket(qindexedlabel(\"ψ_\",\"qboundindex_0\",\"\"))),0,n,\"qboundindex_0\"),4)"
    },
    {
      "id": "IBM091-868393ba-M043",
      "cell": 10,
      "start": 1444,
      "end": 1873,
      "literal": "$$\n\\begin{aligned}\nE_\\text{var}&=\\langle \\psi_\\text{var}|H|\\psi_\\text{var}\\rangle =\\left(\\sum_{i=0}^n c^*_i \\langle \\psi_i|\\right)H\\left(\\sum_{j=0}^n c_j |\\psi_j\\rangle\\right)\\\\\n&=\\left(\\sum_{i=0}^n c^*_i \\langle \\psi_i|\\right)\\left(\\sum_{j=0}^n c_j E_j|\\psi_j\\rangle\\right)\\\\\n&=\\sum_{i,j=0}^n c^*_i c_j E_j \\langle \\psi_i|\\psi_j\\rangle\\\\\n&=\\sum_{i,j=0}^n c^*_i c_j E_j \\delta_{i,j}\\\\\n&=\\sum_{i=0}^n |c_i|^2 E_i.\n\\end{aligned}\n$$",
      "status": "diagnostic",
      "message": "Invalid summation index at byte 292"
    },
    {
      "id": "IBM091-868393ba-M044",
      "cell": 10,
      "start": 1895,
      "end": 1915,
      "literal": "$0\\leq|c_i|^2\\leq 1$",
      "status": "exact",
      "display": "|\"c_i\"| ≥ −1 and |\"c_i\"| ≤ 1",
      "copy": "((qbars(\"c_i\"))<=(1) and (qbars(\"c_i\"))>=(−1))"
    },
    {
      "id": "IBM091-868393ba-M045",
      "cell": 10,
      "start": 1933,
      "end": 2097,
      "literal": "$$\n\\begin{aligned}\nE_\\text{var}&=\\sum_{i=0}^n |c_i|^2 E_i\\geq \\sum_{i=0}^n |c_i|^2 E_0 = E_0 \\sum_{i=0}^n |c_i|^2 = E_0(1) \\\\\nE_\\text{var}&\\geq E_0\n\\end{aligned}\n$$",
