      "copy": "\\begin{gathered}(qindexedlabel(\"q_\",qsub(qadjacent(4,i),3),\"\"))==(qfiniteapply(\"f_0\",i))\\\\(qindexedlabel(\"q_\",qsub(qadjacent(4,i),2),\"\"))==(qfiniteapply(\"f_1\",i))\\\\(qindexedlabel(\"q_\",qsub(qadjacent(4,i),1),\"\"))==(qfiniteapply(\"f_2\",i))\\\\(qfiniteapply(\"f_3\",i))==(\"q_4i\")\\end{gathered}"
