      "literal": "$$\n  M_1 =\n  \\begin{pmatrix}\n    1 & 1\\\\\n    0 & 0\n  \\end{pmatrix},\n  \\hspace{4mm}\n  M_2 =\n  \\begin{pmatrix}\n    1 & 0\\\\\n    0 & 1\n  \\end{pmatrix},\n  \\hspace{4mm}\n  M_3 =\n  \\begin{pmatrix}\n    0 & 1\\\\\n    1 & 0\n  \\end{pmatrix},\n  \\hspace{4mm}\n  M_4 =\n  \\begin{pmatrix}\n    0 & 0\\\\\n    1 & 1\n  \\end{pmatrix}.\n$$",
      "status": "exact",
      "display": "\"M_1\" = [1, 1; 0, 0] and \"M_2\" = [1, 0; 0, 1] and \"M_3\" = [0, 1; 1, 0] and \"M_4\" = [0, 0; 1, 1]",
      "copy": "(qcompare(\"M_1\",matrix(2,2,[1,1,0,0]),4) and qcompare(\"M_2\",matrix(2,2,[1,0,0,1]),4) and qcompare(\"M_3\",matrix(2,2,[0,1,1,0]),4) and qcompare(\"M_4\",matrix(2,2,[0,0,1,1]),4))"
    },
    {
