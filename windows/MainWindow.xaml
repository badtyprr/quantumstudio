<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="QuantumStudio" Width="1200" Height="880" MinWidth="960" MinHeight="700" WindowStartupLocation="CenterScreen" Background="{DynamicResource Theme.Background}" Foreground="{DynamicResource Theme.Text}" FontFamily="Segoe UI">
 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="200"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,1,0">
   <DockPanel Margin="20,28,16,20">
    <StackPanel DockPanel.Dock="Bottom">
     <TextBlock Text="LOCAL WORKSPACE" FontSize="10" Foreground="{DynamicResource Theme.Muted}" Margin="0,16,0,8"/>
     <Button x:Name="Guide" Content="Notation guide ↗" FontSize="12"/>
     <TextBlock Text="Powered by Qalculate!" FontSize="11" Foreground="{DynamicResource Theme.Muted}"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <TextBlock Text="q /" FontSize="38" FontWeight="Light" Foreground="{DynamicResource Theme.Accent}"/>
      <TextBlock Text="QuantumStudio" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,28"/>
      <Border Background="{DynamicResource Theme.Selection}" CornerRadius="7" Padding="12" Margin="0,0,8,12">
       <TextBlock Text="◈  Calculator" FontSize="14"/>
      </Border>
      <Button x:Name="ComposeCircuit" Content="Circuit composer →"/>
      <Button x:Name="BrowseExamples" Content="Explore examples"/>
      <TextBlock Text="QUICK START" Foreground="{DynamicResource Theme.Muted}" FontSize="10" Margin="0,24,0,12"/>
      <Button x:Name="Bell" Content="Bell state" FontSize="12" Padding="10,8"/>
      <Button x:Name="Overlap" Content="State overlap" FontSize="12" Padding="10,8"/>
      <Button x:Name="Reduced" Content="Reduced density" FontSize="12" Padding="10,8"/>
      <Button x:Name="Gates" Content="Gate identities" FontSize="12" Padding="10,8"/>
      <Button x:Name="Phase" Content="Complex phase" ToolTip="Type &lt;i|Y|i&gt; to measure Pauli Y in the +i state." FontSize="12" Padding="10,8"/>
      <Button x:Name="Grover" Content="Grover search" FontSize="12" Padding="10,8"/>
      <Button x:Name="Fourier" Content="Fourier transform" FontSize="12" Padding="10,8"/>
     </StackPanel>
    </ScrollViewer>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="28,24,28,16">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,22">
    <StackPanel>
     <TextBlock Text="QUANTUM WORKSPACE" FontSize="10" Foreground="{DynamicResource Theme.Accent}"/>
     <TextBlock Text="Calculate. Inspect. Explore." FontSize="27" FontWeight="SemiBold" Margin="0,6,0,0"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button x:Name="OpenSession" Content="Open session" FontSize="12" ToolTip="Restore expressions, definitions, and history"/>
     <Button x:Name="SaveSession" Content="Save session" FontSize="12" Margin="0" ToolTip="Save this workspace to a .qsession file"/>
    </StackPanel>
   </DockPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="12" Padding="20">
      <StackPanel>
       <WrapPanel Margin="0,0,0,14">
        <StackPanel Margin="0,0,16,0">
         <TextBlock Text="NOTATION" FontSize="10" Foreground="{DynamicResource Theme.Muted}" Margin="0,0,0,6"/>
         <ComboBox x:Name="Mode" Width="185" SelectedIndex="0" AutomationProperties.Name="Calculation mode">
          <ComboBoxItem Content="Quantum notation"/>
          <ComboBoxItem Content="Standard calculator"/>
         </ComboBox>
        </StackPanel>
        <StackPanel>
         <TextBlock Text="EVALUATION" FontSize="10" Foreground="{DynamicResource Theme.Muted}" Margin="0,0,0,6"/>
         <ComboBox x:Name="Evaluation" Width="170" SelectedIndex="0" AutomationProperties.Name="Evaluation method" ToolTip="Numerical mode evaluates at 30-digit working precision">
          <ComboBoxItem Content="Exact arithmetic"/>
          <ComboBoxItem Content="Numerical"/>
         </ComboBox>
        </StackPanel>
       </WrapPanel>
       <TextBlock Text="EXPRESSION" FontSize="10" Foreground="{DynamicResource Theme.Muted}" Margin="0,0,0,8"/>
       <TextBox x:Name="Input" Text="CNOT (H ⊗ I) |00⟩" MinHeight="100" MaxHeight="190" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cambria Math" FontSize="26" Padding="16" AutomationProperties.Name="Expression"/>
       <WrapPanel x:Name="Palette" Margin="0,12,0,10"/>
       <WrapPanel>
        <Button x:Name="Run" Content="Calculate  →" Background="{DynamicResource Theme.Primary}" Foreground="{DynamicResource Theme.OnPrimary}" Padding="22,10" ToolTip="Enter or Ctrl+Enter calculates; Shift+Enter adds a new line"/>
        <Button x:Name="Cancel" Content="Stop" IsEnabled="False" ToolTip="Stop the current calculation"/>
        <Button x:Name="EditStates" Content="States · 0" ToolTip="Define named states such as Bell and after CZ"/>
        <Button x:Name="EditMatrices" Content="Matrices · 0" ToolTip="Declare matrix symbols and their row and column dimensions"/>
        <ComboBox x:Name="TimeAllowance" SelectedIndex="0" Width="145" Margin="0,0,0,8" ToolTip="Calculation time allowance" AutomationProperties.Name="Calculation time allowance">
         <ComboBoxItem Content="15 seconds"/>
         <ComboBoxItem Content="1 minute"/>
         <ComboBoxItem Content="3 minutes"/>
         <ComboBoxItem Content="10 minutes"/>
        </ComboBox>
       </WrapPanel>
       <TextBlock Text="Enter to calculate · Shift+Enter for a new line" FontSize="11" Foreground="{DynamicResource Theme.Muted}"/>
      </StackPanel>
     </Border>
     <Border Background="{DynamicResource Theme.Input}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,16,0,16">
      <StackPanel>
       <DockPanel>
        <TextBlock x:Name="ResultLabel" Text="RESULT" FontSize="11" Foreground="{DynamicResource Theme.Accent}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button x:Name="Copy" Content="Copy result" HorizontalAlignment="Right" DockPanel.Dock="Right" Padding="10,5" Margin="0" FontSize="12"/>
       </DockPanel>
       <TextBlock x:Name="MatrixCaption" Visibility="Collapsed" Foreground="{DynamicResource Theme.Muted}" FontSize="12" Margin="0,14,0,6"/>
       <ScrollViewer x:Name="MatrixView" Visibility="Collapsed" MaxHeight="280" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Border BorderBrush="{DynamicResource Theme.Accent}" BorderThickness="2,0,2,0" HorizontalAlignment="Left" Margin="0,6,8,8">
         <Grid x:Name="MatrixCells"/>
        </Border>
       </ScrollViewer>
       <TextBox x:Name="Output" Text="Your result will appear here." IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0,14,0,0" FontFamily="Cambria Math" FontSize="26" MinHeight="88" MaxHeight="280" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Calculation result"/>
       <StackPanel x:Name="ProbabilityView" Visibility="Collapsed" Margin="0,20,0,0"/>
      </StackPanel>
     </Border>
     <DockPanel Margin="0,0,0,12">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
       <TextBlock Text="Calculation history" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
       <Button x:Name="Clear" Content="Clear history" FontSize="12" HorizontalAlignment="Right" Padding="10,5" Margin="0"/>
      </DockPanel>
      <ListBox x:Name="History" MinHeight="90" MaxHeight="220" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Calculation history"/>
     </DockPanel>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="2" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
    <TextBlock x:Name="Status" Text="Ready · Exact arithmetic · Leftmost qubit is subsystem 0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Theme.Muted}"/>
   </Border>
  </Grid>
 </Grid>
</Window>
