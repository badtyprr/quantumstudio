<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Quantum Studio · Qalculate!" Width="1160" Height="820" MinWidth="900" MinHeight="670" WindowStartupLocation="CenterScreen" Background="#F5F6FA" FontFamily="Segoe UI" Foreground="#192237">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Background" Value="#EDF0F8"/><Setter Property="Foreground" Value="#263A66"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#6589FF"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="16"/><Setter Property="BorderBrush" Value="#DDE2EE"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/><Setter Property="FontSize" Value="18"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#14213D"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><DockPanel Margin="24,32">
   <StackPanel DockPanel.Dock="Top"><TextBlock Text="q /" Foreground="#94B4FF" FontSize="42" FontWeight="Light"/><TextBlock Text="Quantum Studio" Foreground="White" FontSize="21" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock Text="POWERED BY QALCULATE!" Foreground="#899CBF" FontSize="10" Margin="0,0,0,42"/>
    <TextBlock Text="WORKSPACE" Foreground="#899CBF" FontSize="11" Margin="0,0,0,14"/>
    <TextBlock Text="◈  Quantum calculator" Foreground="#DDE8FF" FontSize="15" Margin="0,0,0,32"/>
    <TextBlock Text="START EXPLORING" Foreground="#899CBF" FontSize="11" Margin="0,0,0,14"/>
    <Button x:Name="Bell" Content="Bell state" HorizontalContentAlignment="Left"/>
    <Button x:Name="Overlap" Content="State overlap"/>
    <Button x:Name="Reduced" Content="Reduced density"/>
    <Button x:Name="Gates" Content="Gate identities"/>
    <Button x:Name="Phase" Content="Complex phase"/>
    <Button x:Name="Grover" Content="Grover search"/>
    <Button x:Name="ComposeCircuit" Content="Compose a circuit →" Background="#375EE8" Foreground="White"/>
    <Button x:Name="BrowseExamples" Content="Browse all examples →" Background="#375EE8" Foreground="White"/>
    <Button x:Name="Fourier" Content="Fourier transform" FontSize="12"/>
   </StackPanel>
   <StackPanel VerticalAlignment="Bottom"><TextBlock Text="LOCAL BY DESIGN" Foreground="#899CBF" FontSize="10"/><TextBlock Text="Exact arithmetic.&#10;Room to experiment." Foreground="#C1CDE3" FontSize="14" LineHeight="23" Margin="0,10,0,16"/><Button x:Name="Guide" Content="Notation guide ↗" Background="#263858" Foreground="#DDE8FF"/></StackPanel>
  </DockPanel></ScrollViewer></Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="36,28,36,24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="140"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,24"><TextBlock Text="A little notation. Endless possibilities." FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Explore states, operators, and the mathematics between them." Foreground="#6C7890" FontSize="14" Margin="0,8,0,0"/></StackPanel>
   <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="24" BorderBrush="#E5E9F2" BorderThickness="1">
    <StackPanel><DockPanel Margin="0,0,0,16"><TextBlock Text="EXPRESSION" FontSize="11" FontWeight="SemiBold" Foreground="#6C7890" VerticalAlignment="Center"/><ComboBox x:Name="Evaluation" DockPanel.Dock="Right" SelectedIndex="0" Width="150" Margin="10,0,0,0" Padding="8" ToolTip="Numerical mode evaluates at 30-digit working precision" AutomationProperties.Name="Evaluation method"><ComboBoxItem Content="Exact arithmetic"/><ComboBoxItem Content="Numerical"/></ComboBox><ComboBox x:Name="Mode" DockPanel.Dock="Right" HorizontalAlignment="Right" SelectedIndex="0" Width="175" Padding="8" AutomationProperties.Name="Calculation mode"><ComboBoxItem Content="Quantum notation"/><ComboBoxItem Content="Standard calculator"/></ComboBox></DockPanel>
     <TextBox x:Name="Input" Text="CNOT (H ⊗ I) |00⟩" MinHeight="92" MaxHeight="170" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cambria Math" FontSize="25" AutomationProperties.Name="Expression"/>
     <WrapPanel x:Name="Palette" Margin="0,14,0,6"/>
     <WrapPanel VerticalAlignment="Center">
      <ComboBox x:Name="TimeAllowance" SelectedIndex="0" Width="155" Padding="8" Margin="0,0,8,8" ToolTip="Maximum time for each new calculation" AutomationProperties.Name="Calculation time allowance"><ComboBoxItem Content="15 seconds"/><ComboBoxItem Content="1 minute"/><ComboBoxItem Content="3 minutes"/><ComboBoxItem Content="10 minutes"/></ComboBox>
      <Button x:Name="Run" Content="Calculate  →" Background="#375EE8" Foreground="White" Padding="20,10" ToolTip="Enter or Ctrl+Enter to calculate; Shift+Enter for a new line"/>
      <Button x:Name="Cancel" Content="Cancel" IsEnabled="False" ToolTip="Stop the current calculation"/>
     </WrapPanel>
    </StackPanel>
   </Border>
   <Border Grid.Row="2" Background="#EAF0FF" CornerRadius="14" Padding="24" Margin="0,18,0,20">
    <StackPanel><DockPanel><TextBlock x:Name="ResultLabel" Text="RESULT" FontSize="11" Foreground="#47659B" FontWeight="SemiBold"/><Button x:Name="Copy" Content="Copy" HorizontalAlignment="Right" DockPanel.Dock="Right" Padding="10,3" Margin="0" Background="Transparent"/></DockPanel><TextBlock x:Name="MatrixCaption" Visibility="Collapsed" Foreground="#47659B" FontSize="11" Margin="0,8,0,6"/><ScrollViewer x:Name="MatrixView" Visibility="Collapsed" MaxHeight="180" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Border BorderBrush="#47659B" BorderThickness="2,0,2,0" HorizontalAlignment="Left" Margin="0,4,8,4"><Grid x:Name="MatrixCells"/></Border></ScrollViewer><TextBox x:Name="Output" Text="Your next discovery starts above." IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0,12,0,0" FontFamily="Cambria Math" FontSize="24" MinHeight="65" MaxHeight="180" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Calculation result"/><StackPanel x:Name="ProbabilityView" Visibility="Collapsed" Margin="0,20,0,0"/></StackPanel>
   </Border>
   <DockPanel Grid.Row="3"><Grid DockPanel.Dock="Top" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Recent calculations" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="OpenSession" Content="Open session" Padding="10,6" Margin="0,0,6,0" ToolTip="Open a saved .qsession file"/><Button x:Name="SaveSession" Content="Save session" Padding="10,6" Margin="0,0,6,0" ToolTip="Save the current expression and calculation history"/><Button x:Name="Clear" Content="Clear" Background="Transparent" Padding="5,6" Margin="0"/></StackPanel></Grid><ListBox x:Name="History" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Calculation history"/></DockPanel>
   <TextBlock x:Name="Status" TextWrapping="Wrap" Grid.Row="4" Text="Ready · Exact arithmetic · Leftmost qubit is subsystem 0" Foreground="#758198" FontSize="11" Margin="0,15,0,0"/>
  </Grid></ScrollViewer>
 </Grid>
</Window>
